rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'HMyGI5u3b5hwvhwWS8GpaalVsYa2';
    }

    // One document per registered account (email/password user). The document
    // id is the account's Firebase Auth uid, so a user can only touch their own.
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // A user may only create their own doc as a fresh trial, stamped with the SERVER time.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['status', 'name', 'email', 'devices', 'firstSeen', 'lastSeen'])
        && request.resource.data.status == 'trial'
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.devices is map && request.resource.data.devices.size() <= 20
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time;

      // A user may only refresh lastSeen, record the browser they use (devices),
      // or move trial -> pending when the trial ends. They can never approve
      // themselves or change name/email/firstSeen.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'status', 'lastSeen'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.devices is map && request.resource.data.devices.size() <= 20
        && (request.resource.data.status == resource.data.status
            || (request.resource.data.status == 'pending' && resource.data.status == 'trial'))
      );

      // Only the admin may delete an entry. (The deleted person's Firebase Auth user still exists;
      // if they log in again they start as a new account with a fresh 30-minute trial.)
      allow delete: if isAdmin();
    }
  }
}
