  .lax-img { touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
  body.gate-locked { overflow: hidden; }
  #access-gate {
    position: fixed; inset: 0; z-index: 100000;
    background: #ffffff; overflow-y: auto;
    display: flex; align-items: center; justify-content: center;
    padding: 24px; font-family: Arial, Helvetica, sans-serif; color: var(--ink);
  }
  #access-gate[hidden] { display: none; }
  .gate-card { max-width: 420px; width: 100%; text-align: center; }
  .gate-card .gate-logo { height: 2.2em; width: auto; margin-bottom: 14px; }
  .gate-card h2 { font-size: 20px; margin: 0 0 8px; }
  .gate-card .welcome-note { text-align: justify; margin: 0 0 14px; }
  .gate-card p { font-size: 14px; color: var(--sub); margin: 0 0 14px; }
  .gate-card input { width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; margin-bottom: 10px; }
  .gate-btn { display: inline-block; font-size: 15px; padding: 10px 18px; border-radius: 8px; border: 1px solid var(--accent); background: var(--accent); color: #fff; cursor: pointer; text-decoration: none; margin: 4px; }
  .gate-btn:hover { background: var(--accent-dark); }
  .gate-btn.alt { background: #fff; color: var(--accent); }
  .gate-code { display: inline-block; font-family: monospace; font-size: 13px; background: var(--disabled-bg); border-radius: 6px; padding: 3px 8px; color: var(--ink); }
  .gate-err { color: #b00020; font-size: 13px; min-height: 1.2em; margin-bottom: 8px; }
  #trial-banner { position: fixed; left: 50%; bottom: 12px; transform: translateX(-50%); z-index: 9000; background: rgba(26,26,26,0.88); color: #fff; font-size: 12.5px; padding: 6px 14px; border-radius: 999px; pointer-events: none; }
  #trial-banner[hidden] { display: none; }
  #admin-login { position: fixed; inset: 0; z-index: 100001; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; padding: 20px; }
  #admin-login[hidden] { display: none; }
  #admin-login .gate-card { background: #fff; border-radius: 12px; padding: 22px; }
  .adm-counts { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
  .adm-chip { font-size: 13px; padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; background: #fff; cursor: pointer; }
  .adm-chip.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  #adm-search { width: 100%; font-size: 15px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 8px; margin-bottom: 12px; }
  .adm-row { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; }
  .adm-name { font-weight: bold; font-size: 15px; flex: 1 1 140px; word-break: break-word; }
  .adm-chips { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin: 6px 0; }
  @media (max-width: 640px) { .adm-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .adm-pill { display: flex; flex-direction: column; gap: 1px; border: 1px solid var(--pc-b, rgba(120,130,150,.35)); background: var(--pc-bg, rgba(120,130,150,.14)); border-left: 4px solid var(--pc-b, rgba(120,130,150,.6)); border-radius: 10px; padding: 4px 10px; font-size: 12px; color: var(--ink); overflow-wrap: anywhere; min-width: 0; }
  .adm-pill small { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: var(--sub); }
  .adm-pill.c-email { --pc-b: #1e6fd9; --pc-bg: rgba(30,111,217,.12); }
  .adm-pill.c-id { --pc-b: #8e44ad; --pc-bg: rgba(142,68,173,.13); }
  .adm-pill.c-reg { --pc-b: #00897b; --pc-bg: rgba(0,137,123,.13); }
  .adm-pill.c-seen { --pc-b: #ef6c00; --pc-bg: rgba(239,108,0,.13); }
  .adm-pill.c-dev { --pc-b: #3949ab; --pc-bg: rgba(57,73,171,.14); font-weight: 700; }
  .adm-pill.c-name { --pc-b: #c79100; --pc-bg: rgba(255,193,7,.18); }
  .adm-pill.c-browser { --pc-b: #546e7a; --pc-bg: rgba(84,110,122,.14); }
  .adm-pill.c-ip { --pc-b: #d81b60; --pc-bg: rgba(216,27,96,.12); }
  .adm-pill.c-in { --pc-b: #2e7d32; --pc-bg: rgba(46,125,50,.14); }
  .adm-pill.c-quit { --pc-b: #c62828; --pc-bg: rgba(198,40,40,.12); }
  .adm-pill.c-dur { --pc-b: #0097a7; --pc-bg: rgba(0,151,167,.13); }
  .adm-pill.c-live { --pc-b: #2e7d32; --pc-bg: #cdeccf; color: #1b5e20; font-weight: 700; }
  .adm-pill.c-off { --pc-b: #78909c; --pc-bg: rgba(120,144,156,.14); }
  .adm-cal { flex: 1 1 100%; border-top: 1px dashed var(--line); padding-top: 8px; font-size: 12px; }
  .adm-cal-head { display: flex; gap: 8px; align-items: center; margin-bottom: 6px; }
  .adm-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; max-width: 460px; }
  .adm-cal-dow { text-align: center; font-weight: 700; color: var(--sub); }
  .adm-cal-day { font-size: 11px; padding: 6px 0; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--sub); cursor: pointer; }
  .adm-cal-day.on { background: #e3f3e6; border-color: #2e7d32; color: #1b5e20; font-weight: 700; }
  .adm-cal-day.sel { outline: 2px solid var(--accent); }
  .adm-cal-title { margin: 8px 0 4px; font-weight: 700; }
  .adm-cal-visit { padding: 2px 0; }
  .adm-meta { font-size: 12px; color: var(--sub); flex: 1 1 100%; }
  .adm-badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: var(--disabled-bg); text-transform: uppercase; letter-spacing: .04em; }
  .adm-badge.pending { background: #fff3cd; } .adm-badge.approved { background: #d4edda; } .adm-badge.revoked { background: #f8d7da; } .adm-badge.blocked { background: #b00020; color: #fff; }
  .adm-blk { font-size: 11px; padding: 1px 8px; margin-left: 4px; border: 1px solid #b00020; color: #fff; background: #b00020; border-radius: 6px; cursor: pointer; }
  .adm-ok { font-size: 13px; display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .adm-ok input { width: 18px; height: 18px; }
  .adm-del { font-size: 11px; padding: 1px 8px; margin-left: 4px; border: 1px solid #b00020; color: #b00020; background: #fff; border-radius: 6px; cursor: pointer; }
  .adm-ren { font-size: 11px; padding: 1px 8px; margin-left: 4px; border: 1px solid var(--accent); color: var(--accent); background: #fff; border-radius: 6px; cursor: pointer; }
