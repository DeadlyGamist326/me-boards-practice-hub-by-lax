    const W = Math.min(par ? par.clientWidth : 0, Math.max(320, Math.round(dw0 / 96 * 320))) - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    if (!(W > 0)) return;
    const dpr = window.devicePixelRatio || 1, key = Math.round(W * 100) + '|' + dpr;
    if (L.key === key) return;
    L.key = key;
    const dw = L.dw || 96;
    const side = !!box.closest('.calc-side');
    let dot = side ? Math.max(1, Math.ceil(W * dpr / dw)) : Math.max(1, Math.round(W * dpr / dw));
    while (!side && dot > 1 && dot * dw / dpr > W * 1.04) dot--;
    const dwReal = calcLcdEngine.draw(L.cv, L.markup, L.ans, dot);
    L.dw = dwReal;
    /* beside the solutions every display is scaled (not stretched) to exactly the box width, so they are all the same width */
    if (side) { L.cv.style.width = W + 'px'; L.cv.style.height = (L.cv.height * W / L.cv.width) + 'px'; }
    else { L.cv.style.width = (dwReal * dot / dpr) + 'px'; L.cv.style.height = (L.cv.height / dpr) + 'px'; }
    if (dwReal !== dw) { L.key = ''; calcLcdFit(box); }
  }
  const calcLcdRO = window.ResizeObserver ? new ResizeObserver(es => es.forEach(e => e.target.querySelectorAll(':scope > .calc-lcd[data-done], :scope > .calc-box > .calc-lcd[data-done]').forEach(calcLcdFit))) : null;
  window.addEventListener('resize', function () { document.querySelectorAll('.calc-lcd[data-done]').forEach(b => { if (b._lcd) b._lcd.key = ''; calcLcdFit(b); }); });
  function calcLcd(root) {
    root.querySelectorAll('.calc-lcd[data-expr]:not([data-done])').forEach(box => {
      const cv = document.createElement('canvas'), ans = box.getAttribute('data-ans') || '', markup = box.getAttribute('data-expr');
      const DW = calcLcdEngine.draw(cv, markup, ans, 3);
      box.style.maxWidth = 'min(100%, ' + Math.max(320, Math.round(DW / 96 * 320)) + 'px)';
      cv.setAttribute('role', 'img'); cv.setAttribute('aria-label', 'Calculator display: ' + markup.replace(/\\[a-z]+|[{}^]/g, ' ') + ' = ' + ans);
      box.setAttribute('title', 'Double-click to copy this equation into the calculator'); box.appendChild(cv); box.setAttribute('data-done', '1');
      box._lcd = {cv, markup, ans, dw: DW, key: ''};
      calcLcdFit(box);
      if (calcLcdRO && box.parentElement) calcLcdRO.observe(box.parentElement);
    });
  }
