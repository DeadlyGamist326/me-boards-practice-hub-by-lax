  /* Five quick taps on the LAX logo open every Full solution (last hint) on the open screen; problems hidden by the Practice by formula filter are skipped. */
(function () {
  let taps = 0, last = 0;
  document.addEventListener('click', (e) => {
    if (!e.target.closest || !e.target.closest('.lax-img')) return;
    const now = Date.now();
    taps = now - last > 1500 ? 1 : taps + 1;
    last = now;
    if (taps < 5) return;
    taps = 0;
    const view = document.querySelector('.view.active');
    if (!view) return;
    const btns = new Set(view.querySelectorAll('.hint-btn.hint-solution'));
    view.querySelectorAll('.hints-wrap').forEach((w) => {
      const all = w.querySelectorAll('.hint-btn');
      if (all.length) btns.add(all[all.length - 1]);
    });
    btns.forEach((b) => { if (b.getClientRects().length && !b.classList.contains('active')) b.click(); });
  });
})();
